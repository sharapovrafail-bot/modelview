<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RafLink"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Телефон ↔ ПК по Wi-Fi"
            android:textColor="@color/text2"
            android:textSize="15sp" />

        <!-- Статус -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/dot" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:textColor="@color/text"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text2"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Код подключения -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Код для подключения ПК" />

                <TextView
                    android:id="@+id/pinText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:textColor="@color/accent"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Введите этот код в программе RafLink на компьютере"
                    android:textColor="@color/text2"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewPin"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:text="Новый код" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Действия -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            style="@style/BigButton"
            android:layout_marginTop="18dp"
            android:text="Отправить файлы на ПК"
            app:icon="@drawable/ic_upload" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhoto"
            style="@style/BigButton"
            android:text="Фото на ПК"
            app:backgroundTint="@color/orange"
            app:icon="@drawable/ic_camera" />

        <!-- Настройка -->
        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Настройка телефона (один раз)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiles"
            style="@style/SetupButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotif"
            style="@style/SetupButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBattery"
            style="@style/SetupButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutostart"
            style="@style/SetupButton"
            android:text="Автозапуск (Xiaomi)  →" />

        <!-- Журнал -->
        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Последние передачи" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/text"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
